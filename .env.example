# Only this checkout's .env is read. Shell variables override these values.
FIRECRAWL_API_KEY=
TYPESAFE_API_KEY=

# Uses the local Argo shim by default. Codex OAuth requires an explicit provider choice.
EPISODIC_LLM_PROVIDER=argo
EPISODIC_LLM_BASE_URL=http://127.0.0.1:12329/v1
# Argo caller identity (defaults to the local username).
EPISODIC_LLM_USER=
# REASONING tier (scientific decisions, page-child choice, report/lexical extraction)
EPISODIC_LLM_MODEL='GPT-6.1 Sol'
EPISODIC_LLM_REASONING_EFFORT=medium
# FAST tier (search-page choice, table-page extraction)
EPISODIC_LLM_FAST_MODEL='GPT-6 Luna'
EPISODIC_LLM_FAST_REASONING_EFFORT=none

FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
FIRECRAWL_SCRAPE_RESULTS=false
TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-1.13.0
EPISODIC_REQUEST_TIMEOUT_S=300

# Used only when running scripts/check.py --live.
EPISODIC_TEST_RESEARCH_REQUEST=
EPISODIC_TEST_REPORT_PATH=
