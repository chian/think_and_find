# Only this checkout's .env is read. Shell variables override these values.
FIRECRAWL_API_KEY=
TYPESAFE_API_KEY=

# Switch between argo and codex_oauth with this one setting.
EPISODIC_LLM_PROVIDER=argo
# Argo connection settings are ignored by codex_oauth.
EPISODIC_LLM_BASE_URL=http://127.0.0.1:12329/v1
# Argo caller identity (defaults to the local username).
EPISODIC_LLM_USER=
# REASONING tier (scientific decisions, page-child choice, report/lexical extraction)
EPISODIC_LLM_ARGO_MODEL='GPT-6.1 Sol'
EPISODIC_LLM_ARGO_REASONING_EFFORT=medium
# FAST tier (search-page choice)
EPISODIC_LLM_ARGO_FAST_MODEL='GPT-6 Luna'
EPISODIC_LLM_ARGO_FAST_REASONING_EFFORT=none

# Reuses the current Codex CLI ChatGPT login; do not copy OAuth tokens here.
# CODEX_HOME, when set, selects that CLI login's directory.
EPISODIC_LLM_CODEX_OAUTH_MODEL=gpt-6.1-sol
EPISODIC_LLM_CODEX_OAUTH_REASONING_EFFORT=medium
EPISODIC_LLM_CODEX_OAUTH_FAST_MODEL=gpt-6-luna
EPISODIC_LLM_CODEX_OAUTH_FAST_REASONING_EFFORT=low

FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
FIRECRAWL_SCRAPE_RESULTS=false
TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-1.13.0
